NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017/campusconnect?replicaSet=rs0
REDIS_URL=redis://localhost:6379
CLIENT_ORIGIN=http://localhost:5173
SERVE_WEB_CLIENT=false
WEB_DIST_PATH=
INITIALIZE_DATABASE_ON_START=false
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
DEFAULT_TENANT_SLUG=campusconnect-demo
SEED_TENANT_NAME=CampusConnect Demo Campus
SEED_TENANT_DOMAIN=campusconnect.example
SMTP_URL=
MAIL_FROM=CampusConnect <no-reply@campusconnect.example>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EVENT_TICKET_SECRET=replace-with-at-least-32-random-characters
